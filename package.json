{
  "name": "@droyds/monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "src/core",
    "src/bots",
    "src/server",
    "src/website"
  ],
  "scripts": {
    "init": "./tasks/init",
    "dev": "concurrently -n \"Website,Server,Bots,Core,Database\" -c \"blue,green,magenta,yellow,white\" \"npm:dev:website\" \"npm:dev:server\" \"npm:dev:bots\" \"npm:dev:core\" \"npm:dev:db\"",
    "dev:website": "wait-on tcp:3000 && npm run dev --workspace=@droyds/website",
    "dev:server": "npm run dev --workspace=@droyds/server",
    "dev:bots": "npm run dev --workspace=@droyds/bots",
    "dev:core": "npm run dev --workspace=@droyds/core",
    "dev:db": "npm run dev:db --workspace=@droyds/core",
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "migrate": "npm run migrate --workspace=@droyds/core",
    "generate": "npm run generate --workspace=@droyds/core"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.1.0"
  }
}
