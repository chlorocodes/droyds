generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Droyd {
  id    String @id @default(uuid()) @map("id")
  name  String @map("name")
  color String @map("color")
}

model Session {
  id       String  @id @map("id")
  userId   String? @map("user_id")
  username String? @map("username")

  @@map("sessions")
}

model ServerState {
  id             String @id @default(uuid()) @map("id")
  serverId       String @unique @map("server_id")
  currentStoryId String @map("current_story_id")
  lastAuthorId   String @map("last_author_id")
  lastWord       String @map("last_word")

  currentStory OneWordStory @relation(fields: [currentStoryId], references: [id], onDelete: Restrict)
  lastAuthor   Author       @relation(fields: [lastAuthorId], references: [id], onDelete: Restrict)

  @@map("server_states")
}

model OneWordStory {
  id         String   @id @default(uuid()) @map("id")
  name       String   @default("") @map("name")
  isComplete Boolean  @default(false) @map("is_complete")
  createdAt  DateTime @default(now()) @map("created_at")

  words       Word[]
  serverState ServerState[]

  @@map("stories")
}

model Author {
  id        String   @id @default("1311745612902957107") @map("id")
  username  String   @default("Vybe") @map("username")
  avatar    String   @map("avatar")
  createdAt DateTime @default(now()) @map("created_at")

  words       Word[]
  serverState ServerState[]

  @@map("authors")
}

model Word {
  id               String   @id @default(uuid()) @map("id")
  word             String   @map("word")
  storyId          String   @map("story_id")
  authorId         String   @map("author_id")
  discordMessageId String   @map("discord_message_id")
  createdAt        DateTime @default(now()) @map("created_at")

  story  OneWordStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  author Author       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([storyId]) // Optimize querying words by story
  @@map("words")
}
